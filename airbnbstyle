<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fern Cabin — Find your quiet</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#f5efe6;
    --cream-2:#ece4d7;
    --ink:#1e1d1a;
    --muted:#6b665d;
    --forest:#1f2e24;
    --forest-2:#2a3b2f;
    --line:#d9d0c1;
    --serif:'Cormorant Garamond', Georgia, serif;
    --sans:'Jost', 'Helvetica Neue', Arial, sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--cream);color:var(--ink);font-family:var(--sans);font-weight:300;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  img{display:block;width:100%;height:100%;object-fit:cover}
  .wrap{max-width:1200px;margin:0 auto;padding:0 40px}
  .eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:400}

  /* ---------- Header ---------- */
  header{position:absolute;top:0;left:0;right:0;z-index:10}
  .nav{display:flex;align-items:center;justify-content:space-between;padding:26px 40px;max-width:1280px;margin:0 auto}
  .logo{display:flex;align-items:center;gap:14px}
  .logo svg{width:26px;height:34px}
  .logo .name{font-family:var(--serif);font-size:26px;letter-spacing:.32em;line-height:1}
  .logo .sub{display:block;font-family:var(--sans);font-size:9px;letter-spacing:.42em;margin-top:4px;text-align:center}
  .menu{display:flex;gap:46px;font-family:var(--serif);font-size:17px}
  .menu a{position:relative}
  .menu a::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:1px;background:currentColor;transition:width .3s}
  .menu a:hover::after{width:100%}
  .tagline{font-size:10px;letter-spacing:.24em;text-transform:uppercase;text-align:right;line-height:1.6;color:#fff}
  .tagline::after{content:"";display:block;width:28px;height:1px;background:#fff;margin:8px 0 0 auto}

  /* ---------- Hero ---------- */
  .hero{position:relative;height:640px;overflow:hidden;
    background:linear-gradient(180deg,#d9cbb8 0%,#bfb19c 45%,#5d6a5a 75%,#2c3a2e 100%)}
  .hero .bg{position:absolute;inset:0}
  .hero .bg img{object-position:center 55%}
  .hero::before{content:"";position:absolute;inset:0;z-index:1;
    background:linear-gradient(90deg,rgba(245,239,230,.92) 0%,rgba(245,239,230,.65) 28%,rgba(245,239,230,0) 55%),
               linear-gradient(180deg,rgba(245,239,230,.85) 0%,rgba(245,239,230,0) 22%)}
  .hero-copy{position:relative;z-index:2;padding:170px 0 0}
  .hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(56px,8vw,104px);line-height:.92;letter-spacing:-.01em}
  .hero .lead{margin:34px 0 0 64px;font-size:12px;letter-spacing:.3em;line-height:1.8}

  /* ---------- Booking bar ---------- */
  .booking{position:relative;z-index:5;margin-top:-90px}
  .booking form{display:grid;grid-template-columns:1fr 1fr 1fr auto;background:var(--cream);box-shadow:0 18px 40px rgba(20,25,20,.18);padding:8px}
  .field{display:flex;align-items:center;gap:16px;padding:12px 22px;border-right:1px solid var(--line);cursor:pointer}
  .field:nth-child(3){border-right:none}
  .field svg{width:18px;height:18px;flex-shrink:0;stroke:var(--ink)}
  .field label{display:block;font-size:11px;color:var(--muted)}
  .field input,.field select{border:none;background:transparent;font-family:var(--sans);font-size:16px;color:var(--ink);outline:none;width:100%;appearance:none;-webkit-appearance:none;cursor:pointer}
  .field .chev{margin-left:auto;width:12px;height:12px}
  .btn-dark{background:var(--forest);color:var(--cream);border:none;font-family:var(--sans);font-size:15px;letter-spacing:.06em;padding:0 34px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:background .25s}
  .btn-dark:hover{background:var(--forest-2)}
  .arrow{display:inline-block;width:18px;height:10px}

  /* ---------- Features ---------- */
  .features{display:grid;grid-template-columns:repeat(4,1fr);padding:54px 0 40px}
  .feature{text-align:center;padding:0 20px;border-right:1px solid var(--line)}
  .feature:last-child{border-right:none}
  .feature svg{width:30px;height:30px;stroke:var(--ink);fill:none;stroke-width:1.2;margin-bottom:14px}
  .feature h3{font-size:11px;letter-spacing:.24em;font-weight:500;margin-bottom:10px}
  .feature p{font-size:13px;color:var(--muted);line-height:1.55}

  /* ---------- Cabins ---------- */
  .cabins{padding:30px 0 70px}
  .section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:30px}
  .section-head .eyebrow{color:var(--muted);font-size:10px;margin-bottom:12px}
  .section-head h2{font-family:var(--serif);font-weight:400;font-size:clamp(36px,4.4vw,52px);line-height:1}
  .link-line{display:flex;align-items:center;gap:12px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;padding-bottom:8px;border-bottom:1px solid var(--ink)}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .card{background:#faf6f0;transition:transform .35s ease, box-shadow .35s ease}
  .card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(30,30,25,.12)}
  .card .img{aspect-ratio:16/10;overflow:hidden;background:linear-gradient(160deg,#6f7c6a,#2c3a2e)}
  .card .img img{transition:transform .6s ease}
  .card:hover .img img{transform:scale(1.05)}
  .card .body{padding:20px 22px 22px}
  .card h3{font-family:var(--serif);font-weight:500;font-size:24px;margin-bottom:6px}
  .card .meta{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
  .card .row{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
  .card p{font-size:14px;line-height:1.5;color:#3d3a34}

  /* ---------- Wellness ---------- */
  .wellness{display:grid;grid-template-columns:1fr 1fr;min-height:470px}
  .wellness .img{overflow:hidden;background:linear-gradient(135deg,#7a5434,#2a1d14)}
  .wellness .panel{background:var(--forest);color:var(--cream);padding:80px 60px;position:relative;display:flex;flex-direction:column;justify-content:center;overflow:hidden}
  .wellness .eyebrow{font-size:10px;opacity:.85;margin-bottom:20px}
  .wellness h2{font-family:var(--serif);font-weight:400;font-size:clamp(38px,4vw,50px);line-height:1.05;margin-bottom:22px}
  .wellness p{font-size:15px;line-height:1.65;max-width:360px;opacity:.9;margin-bottom:32px}
  .btn-light{align-self:flex-start;background:var(--cream);color:var(--ink);font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:16px 26px;display:inline-flex;gap:14px;align-items:center;transition:background .25s}
  .btn-light:hover{background:#fff}
  .fern-sprig{position:absolute;right:30px;bottom:40px;width:150px;opacity:.55;stroke:var(--cream);fill:none;stroke-width:1}

  /* ---------- Footer ---------- */
  footer{background:var(--forest);color:var(--cream);position:relative}
  .treeline{display:block;width:100%;height:140px;background:var(--cream)}
  .foot{display:flex;align-items:center;justify-content:space-between;padding:40px 40px 50px;max-width:1280px;margin:0 auto}
  footer .logo svg{stroke:var(--cream)}
  footer .menu{gap:40px;font-size:16px}
  .foot-right{display:flex;align-items:center;gap:60px}
  .foot-right .tagline{text-align:left;color:var(--cream)}
  .foot-right .tagline::after{margin:8px 0 0 0;background:var(--cream)}
  .social{display:flex;gap:18px}
  .social svg{width:18px;height:18px;fill:none;stroke:var(--cream);stroke-width:1.5}

  /* ---------- Responsive ---------- */
  @media (max-width:960px){
    .menu{gap:24px}
    .tagline{display:none}
    .booking form{grid-template-columns:1fr 1fr}
    .field:nth-child(2){border-right:none}
    .field:nth-child(3){border-top:1px solid var(--line)}
    .booking .btn-dark{border-top:8px solid var(--cream);justify-content:center;padding:18px}
    .features{grid-template-columns:repeat(2,1fr);row-gap:36px}
    .feature:nth-child(2){border-right:none}
    .grid{grid-template-columns:1fr 1fr}
    .wellness{grid-template-columns:1fr}
    .wellness .img{height:340px}
    .foot{flex-direction:column;gap:30px}
  }
  @media (max-width:640px){
    .wrap,.nav,.foot{padding-left:16px;padding-right:16px}
    header .menu{display:none}
    .hero{height:560px}
    .hero-copy{padding-top:140px}
    .hero .lead{margin-left:4px}
    .booking form{grid-template-columns:1fr}
    .field{border-right:none;border-bottom:1px solid var(--line)}
    .features{grid-template-columns:1fr}
    .feature{border-right:none}
    .grid{grid-template-columns:1fr}
    .section-head{flex-direction:column;align-items:flex-start;gap:20px}
    .wellness .panel{padding:56px 24px}
    .foot-right{flex-direction:column;gap:24px}
    footer .menu{gap:22px}
  }
</style>
</head>
<body>

